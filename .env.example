# MongoDB Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sporttock?retryWrites=true&w=majority

# OpenAI API Key (for quiz generation)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Web Push (VAPID Keys) - Generate at https://vapidkeys.com/
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Cron Job Secret (for daily ranking snapshots)
CRON_SECRET=your-random-secret-here
